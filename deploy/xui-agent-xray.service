[Unit]
Description=xui-stack managed Xray runtime
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/xui-agent/xray-config/current.json
StartLimitIntervalSec=0

[Service]
Type=simple
User=xui-agent
Group=xui-agent
ExecStart=/usr/local/bin/xui-agent xray-run -config /etc/xui-agent/config.json
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xui-agent
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
